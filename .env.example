# ESPN Fantasy Football private league credentials.
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# The numeric ID of your ESPN fantasy football league (found in the league URL).
LEAGUE_ID=

# ESPN session cookies used to authenticate against private leagues.
# See README.md for instructions on retrieving these from your browser.
ESPN_S2=
SWID=

# Optional: current season year. Defaults to the current calendar year if unset.
CURRENT_SEASON=

# Optional: enables Claude-generated weekly recap commentary.
# If unset, the app falls back to deterministic placeholder commentary.
ANTHROPIC_API_KEY=

# Optional: licensed FantasyPros API key (api.fantasypros.com), used for
# rest-of-season rankings in Roster Strength. Not required to run the app.
FANTASYPROS_API_KEY=

# Optional: enables the "Ask Me Anything" page (Gemini-powered natural-
# language Q&A over league history/rosters). Without it, that page shows
# a setup message instead of crashing. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model used for Ask Me Anything. Defaults
# to gemini-2.5-flash if unset - check https://ai.google.dev/gemini-api/docs/models
# for the current recommended Flash model before changing this.
GEMINI_MODEL=

# Optional: a shared password required to use the whole app - meant for a
# hosted deployment reachable by more than just you (e.g. Streamlit
# Community Cloud), not local dev. Leave unset locally - the app skips
# the password prompt entirely when this is empty.
APP_PASSWORD=

# Optional: enables scheduled GroupMe posts (matchup slate updates,
# weekly waiver recap - see scripts/post_*.py and .github/workflows/).
# Create a Bot for your group at https://dev.groupme.com/bots, then paste
# its bot_id here (and as a GitHub Actions secret of the same name).
GROUPME_BOT_ID=
