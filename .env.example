# ESPN Fantasy Football private league credentials.
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# The numeric ID of your ESPN fantasy football league (found in the league URL).
LEAGUE_ID=

# ESPN session cookies used to authenticate against private leagues.
# See README.md for instructions on retrieving these from your browser.
ESPN_S2=
SWID=

# Optional: current season year. Defaults to the current calendar year if unset.
CURRENT_SEASON=

# Optional: enables Claude-generated weekly recap commentary.
# If unset, the app falls back to deterministic placeholder commentary.
ANTHROPIC_API_KEY=

# Optional: licensed FantasyPros API key (api.fantasypros.com), used for
# rest-of-season rankings in Roster Strength. Not required to run the app.
FANTASYPROS_API_KEY=
